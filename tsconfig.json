{
  "//": "Type checking only. The project ships plain ES modules and has no build step, so this never emits: it type-checks the JavaScript in place via JSDoc.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.mjs", "server/**/*.mjs", "api/**/*.mjs", "tests/**/*.mjs"],
  "exclude": ["node_modules", "karats-pdf-libs", "app", "sw.js"]
}
