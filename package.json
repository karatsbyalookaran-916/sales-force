{
  "name": "karats-team-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "prisma generate",
    "dev": "node --watch server/server.mjs",
    "start": "node server/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node --test tests/store-postgres.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "create-admin": "node server/create-admin.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "prisma": "^6.12.0",
    "typescript": "^5.9.3"
  }
}
