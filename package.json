{
  "name": "karats-team-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "prisma generate",
    "dev": "node --watch server/server.mjs",
    "start": "node server/server.mjs",
    "create-admin": "node server/create-admin.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "prisma migrate dev --name init",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prisma": "^6.12.0"
  }
}
