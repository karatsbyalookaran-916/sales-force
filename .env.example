# Supabase Transaction pooler URL (port 6543), used by the Vercel application.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase direct connection URL (port 5432), used only for Prisma migrations.
DIRECT_URL="postgresql://postgres:PASSWORD@DIRECT-HOST:5432/postgres"
